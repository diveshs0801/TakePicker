# ==============================================================================
# TakePicker Environment Configuration Template
# Copy this file to .env and insert your API keys / configuration values.
# NOTE: .env is ignored by git to prevent leaking secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 🧠 AI Video Copilot & LLM Provider Configuration
# ------------------------------------------------------------------------------
# Choose a provider: deepseek, groq, gemini, openrouter, ollama, openai
# Or simply set the API key for your chosen provider below.

# 1. DeepSeek (Default - Recommended: high accuracy & cost-effective tool calling)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 2. Groq (Free tier available at https://console.groq.com)
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=llama-3.3-70b-versatile

# 3. Google Gemini (Free tier available at https://aistudio.google.com)
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.0-flash

# 4. OpenRouter (Access 100+ models at https://openrouter.ai)
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# 5. Ollama (100% Free & Local, runs fully offline without an API key)
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.1

# 6. Generic OpenAI-Compatible Override
# LLM_PROVIDER=deepseek
# LLM_API_KEY=your_api_key_here
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

# ------------------------------------------------------------------------------
# ⚙️ Infrastructure & Service Settings (Optional - Defaults work out of the box)
# ------------------------------------------------------------------------------
# PORT=3000
# DATABASE_URL=postgres://tp:tp@localhost:5433/takepicker
# REDIS_URL=redis://localhost:6379
# MEDIA_DIR=/media
# API_URL=http://localhost:3000
# ANALYSIS_URL=http://localhost:8000
# FFMPEG_THREADS=2
