# ==========================================
# TakePicker Environment Configuration Template
# ==========================================

# ------------------------------------------
# 🧠 LLM Provider Configuration
# ------------------------------------------
# Choose a provider: deepseek, groq, gemini, openrouter, together, mistral, ollama, openai
# Or simply set the API key for your chosen provider below.

# 1. DeepSeek (Default - Recommended: cheap & strong tool calling)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 2. Groq (Free tier available at console.groq.com)
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile

# 3. Google Gemini (Free tier available at aistudio.google.com)
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-2.0-flash

# 4. OpenRouter (Access 100+ models, openrouter.ai)
# OPENROUTER_API_KEY=sk-or-v1-...

# 5. Ollama (100% Free & Local, runs without API key)
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.1

# 6. Generic OpenAI-compatible override
# LLM_PROVIDER=deepseek
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=
